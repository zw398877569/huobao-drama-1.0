#!/usr/bin/env bash
# Pre-commit hook for huobao-drama-1.0:
#   1. SKILL.md size budget (5KB warn / 8KB block) — prevent agent timeout
#   2. Composable TDZ scan (if episodeNumber.vue changed) — prevent runtime ReferenceError
#   3. Template orphan scan (if episodeNumber.vue changed) — prevent 'X is not a function'
#   4. Dockerfile structure lint (if Dockerfile changed) — prevent orphan WORKDIR/COPY/RUN
#   5. Trailing-quote scan (if any .ts/.vue changed) — prevent 'Unterminated string literal'
#
# Override (NOT recommended): git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
FAILED=0

# ── 1. SKILL.md size budget ─────────────────────────────────────
SKILLS_DIR="$REPO_ROOT/skills"
if [ -d "$SKILLS_DIR" ]; then
  WARN_THRESHOLD=5120
  FAIL_THRESHOLD=8192
  skill_failed=0
  skill_warned=0
  while IFS= read -r f; do
    size=$(wc -c < "$f")
    rel=${f#"$REPO_ROOT"/}
    if [ "$size" -gt "$FAIL_THRESHOLD" ]; then
      echo "[skill-size-check] BLOCK: $rel is $size bytes (>$FAIL_THRESHOLD)"
      echo "  -> Move detail to a sibling .md and turn SKILL.md into an index+pointer."
      echo "  -> See commit 8dc7293 for the 41KB H3 incident."
      skill_failed=1
    elif [ "$size" -gt "$WARN_THRESHOLD" ]; then
      echo "[skill-size-check] WARN: $rel is $size bytes (>$WARN_THRESHOLD) — consider trimming"
      skill_warned=1
    fi
  done < <(find "$SKILLS_DIR" -name "SKILL.md" -type f)
  if [ "$skill_failed" -eq 1 ]; then
    FAILED=1
  elif [ "$skill_warned" -eq 1 ]; then
    echo "[skill-size-check] OK with warnings."
  else
    echo "[skill-size-check] OK — all SKILL.md files under $WARN_THRESHOLD bytes."
  fi
fi

# ── 2 + 3. Episode page static checks (only if file was changed) ─
EPISODE_FILE="$REPO_ROOT/frontend/app/pages/drama/[id]/episode/[episodeNumber].vue"
if git diff --cached --name-only | grep -q "frontend/app/pages/drama/\[id\]/episode/\[episodeNumber\].vue"; then
  if [ -f "$REPO_ROOT/scripts/check-composable-tdz.js" ]; then
    echo "[tdz-check] Running composable TDZ scan..."
    if ! node "$REPO_ROOT/scripts/check-composable-tdz.js" 2>&1; then
      FAILED=1
    fi
  fi
  if [ -f "$REPO_ROOT/scripts/scan-template-orphans.js" ]; then
    echo "[orphan-check] Running template orphan scan..."
    if ! node "$REPO_ROOT/scripts/scan-template-orphans.js" 2>&1; then
      FAILED=1
    fi
  fi
fi

# ── 4. Dockerfile structure lint (only if file was changed) ─
if git diff --cached --name-only | grep -q "^Dockerfile$"; then
  if [ -f "$REPO_ROOT/scripts/check-dockerfile-structure.js" ]; then
    echo "[dockerfile-lint] Checking Dockerfile structure..."
    if ! node "$REPO_ROOT/scripts/check-dockerfile-structure.js" 2>&1; then
      FAILED=1
    fi
  fi
fi

# ── 5. Trailing-quote scan (if any .ts/.vue changed) ─
CHANGED_CODE=$(git diff --cached --name-only | grep -E '\.(ts|vue|tsx|js)$' | grep -v '^scripts/' || true)
if [ -n "$CHANGED_CODE" ]; then
  if [ -f "$REPO_ROOT/scripts/scan-trailing-quote.js" ]; then
    echo "[trailing-quote-check] Scanning for .join('...')' typos..."
    if ! node "$REPO_ROOT/scripts/scan-trailing-quote.js" 2>&1; then
      FAILED=1
    fi
  fi
fi

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "Pre-commit checks failed. To override (NOT recommended): git commit --no-verify"
  exit 1
fi

exit 0
